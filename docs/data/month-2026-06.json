tion-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/sanchezcastejon/with_replies?cursor=DAAHCgABHVwY99w__ooLAAIAAAATMjA3NDQzNjMxNTA3NzA5OTgzMQgAAwAAAAIAAA","text_truncated":false},{"id":"x-2071888907428352305","post_id":"2071888907428352305","platform":"x","author":"sanchezcastejon","original_url":"https://x.com/sanchezcastejon/status/2071888907428352305","published_at":"2026-06-30T09:29:44.022Z","published_date":"2026-06-30","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"La integración es un compromiso compartido.\n\nLa sociedad española debe garantizar la igualdad de trato, combatir la discriminación y ofrecer oportunidades.\n\nY quienes llegan deben respetar nuestras leyes, aprender nuestras lenguas oficiales y compartir los valores democráticos que nos definen.","post_kind":"original","is_repost":false,"author_verified":true,"like_count":2379,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/sanchezcastejon/with_replies?cursor=DAAHCgABHVwY99w__ooLAAIAAAATMjA3NDQzNjMxNTA3NzA5OTgzMQgAAwAAAAIAAA","sha256":"6e07142a6e09793eda86d819323492a01223c1bf706f94923ce522f454de26bb","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/sanchezcastejon/with_replies?cursor=DAAHCgABHVwY99w__ooLAAIAAAATMjA3NDQzNjMxNTA3NzA5OTgzMQgAAwAAAAIAAA","text_truncated":false},{"id":"x-2071878342987399418","post_id":"2071878342987399418","platform":"x","author":"sanchezcastejon","original_url":"https://x.com/sanchezcastejon/status/2071878342987399418","published_at":"2026-06-30T08:47:45.263Z","published_date":"2026-06-30","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"La mejor integración empieza antes de cruzar la frontera: con un contrato, una situación regular y un proyecto de vida. La exclusión no protege a nadie. \n\nLa Estrategia de Movilidad Laboral y la futura Agencia Estatal de Movilidad Humana ofrecen más orden para el Estado, menos incertidumbre para las personas y más seguridad para todos y todas.","post_kind":"original","is_repost":false,"author_verified":true,"like_count":2703,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/sanchezcastejon/with_replies?cursor=DAAHCgABHVwY99w__ooLAAIAAAATMjA3NDQzNjMxNTA3NzA5OTgzMQgAAwAAAAIAAA","sha256":"6e07142a6e09793eda86d819323492a01223c1bf706f94923ce522f454de26bb","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/sanchezcastejon/with_replies?cursor=DAAHCgABHVwY99w__ooLAAIAAAATMjA3NDQzNjMxNTA3NzA5OTgzMQgAAwAAAAIAAA","text_truncated":false},{"id":"x-2071876459224813723","post_id":"2071876459224813723","platform":"x","author":"sanchezcastejon","original_url":"https://x.com/sanchezcastejon/status/2071876459224813723","published_at":"2026-06-30T08:40:16.139Z","published_date":"2026-06-30","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"El Plan de Integración y Ciudadanía, dotado inicialmente con más de 500 M€, es la propuesta de España para gestionar las migraciones de una forma ordenada, justa e inteligente.\n\nUn plan para mejorar la vida de quienes llegan a nuestro país, aprovechar las oportunidades que aporta la migración y responder a los desafíos que genera.\n\nPorque la humanidad sin gestión se queda en palabras. Y la gestión sin humanidad pierde su sentido.","post_kind":"original","is_repost":false,"author_veri